{
  "info": {
    "name": "PoC LLM UFC",
    "description": "Coleção completa da API do LMS PoC LLM UFC. Após fazer login, o token é salvo automaticamente nas variáveis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Cadastro",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/cadastro",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Professor Teste\",\n  \"cpf\": \"111.111.111-11\",\n  \"email\": \"prof@teste.com\",\n  \"senha\": \"senha123\",\n  \"perfil\": \"PROFESSOR\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"prof@teste.com\",\n  \"senha\": \"senha123\"\n}"
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.data) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ufc.br\",\n  \"senha\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Listar Usuários",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/usuarios",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Ativar Usuário",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/usuarios/3/ativar",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Desativar Usuário",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/usuarios/3/desativar",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Perfil",
      "item": [
        {
          "name": "Ver Perfil",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/perfil",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Alterar Senha",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/perfil/senha",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"senhaAtual\": \"senha123\",\n  \"novaSenha\": \"novaSenha123\"\n}"
            }
          }
        },
        {
          "name": "Atualizar Foto de Perfil",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/perfil/foto",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "foto", "type": "file", "src": "" }]
            }
          }
        }
      ]
    },
    {
      "name": "Cursos",
      "item": [
        {
          "name": "Listar Cursos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/cursos",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Buscar Cursos",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/cursos/buscar?q=java",
              "host": ["{{baseUrl}}"],
              "path": ["cursos", "buscar"],
              "query": [{ "key": "q", "value": "java" }]
            },
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        },
        {
          "name": "Criar Curso",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/cursos",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "dados",
                  "value": "{\"titulo\":\"Curso de Java\",\"categoria\":\"Tecnologia\",\"descricao\":\"Aprenda Java do zero\",\"cargaHoraria\":\"40h\"}",
                  "type": "text",
                  "contentType": "application/json"
                },
                { "key": "capa", "type": "file", "src": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Editar Curso",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/cursos/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "dados",
                  "value": "{\"titulo\":\"Curso de Java Atualizado\",\"categoria\":\"Tecnologia\",\"descricao\":\"Aprenda Java\",\"cargaHoraria\":\"40h\"}",
                  "type": "text",
                  "contentType": "application/json"
                },
                { "key": "capa", "type": "file", "src": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Alterar Status do Curso",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/cursos/1/status",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLICADO\"\n}"
            }
          }
        },
        {
          "name": "Configurar Dados de Matrícula",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/cursos/1/dados-matricula",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requerEndereco\": true,\n  \"requerGenero\": false,\n  \"requerIdade\": true\n}"
            }
          }
        },
        {
          "name": "Deletar Curso",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/cursos/1",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }]
          }
        }
      ]
    },
    {
      "name": "Módulos",
      "item": [
